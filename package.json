{
  "name": "contractor-crm-adapters",
  "version": "0.1.0",
  "description": "Typed TypeScript clients for the roofing and home-improvement CRMs JobNimbus and AccuLynx: one normalized contact shape, injectable fetch, timeouts, pagination and Retry-After handling.",
  "keywords": [
    "jobnimbus",
    "acculynx",
    "crm",
    "roofing",
    "contractor",
    "home-improvement",
    "api-client",
    "typescript"
  ],
  "homepage": "https://github.com/nussbeck-labs/contractor-crm-adapters#readme",
  "bugs": {
    "url": "https://github.com/nussbeck-labs/contractor-crm-adapters/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nussbeck-labs/contractor-crm-adapters.git"
  },
  "license": "Apache-2.0",
  "author": "GoodHandoff (https://goodhandoff.com)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "NOTICE",
    "TRADEMARKS.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:docs && npm run check:licenses",
    "prepack": "npm run clean && npm run build",
    "prepare": "npm run build",
    "test:coverage": "vitest run --coverage",
    "check:docs": "node scripts/check-docs.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
